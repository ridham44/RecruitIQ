# ─── Database ────────────────────────────────────────────────
# Any PostgreSQL provider works: Neon, Supabase, Railway, Render, local, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/recruitiq?schema=public"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ─── AI (OpenRouter) ─────────────────────────────────────────
# Never hard-code a model name in application code — always read it from here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_SITE_URL="http://localhost:5173"
OPENROUTER_APP_NAME="RecruitIQ"

# ─── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# ─── Uploads (dev only — see README for production storage notes) ──
UPLOAD_DIR="./uploads"
MAX_RESUME_SIZE_MB=5

# ─── Phase 2 (future — not required for Phase 1) ────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# ─── Phase 3 (future — not required for Phase 1) ────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
