# Same LiveKit project as the main app's .env — this worker joins rooms as
# the "ai-interviewer" participant using its own signed token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — used for both STT (realtime streaming) and TTS (REST).
DEEPGRAM_API_KEY=
# Optional: defaults to aura-2-thalia-en.
DEEPGRAM_TTS_MODEL=

# The main Vercel app's URL and the same INTERVIEW_WORKER_SECRET set there
# — this worker never talks to the database or OpenRouter directly, only to
# this app's /api/v1/interviews/*/worker/* endpoints.
BACKEND_URL=http://localhost:3001
INTERVIEW_WORKER_SECRET=

# Port this worker's own HTTP server listens on for LiveKit's room_started
# webhook. Point your LiveKit project's webhook URL at
# http://<this-service>:<WEBHOOK_PORT>/webhook/livekit.
WEBHOOK_PORT=4001
