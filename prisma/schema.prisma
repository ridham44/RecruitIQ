// Prisma schema for RecruitIQ — Phase 1
// Designed so Phase 2 (notifications, scheduling) and Phase 3 (interviews)
// can be added as new models/relations without altering these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // In production, DATABASE_URL should be your provider's POOLED connection
  // string — serverless functions open a fresh connection pool per
  // instance, and an unpooled URL exhausts small Postgres plans fast. If
  // your provider's pooled URL can't run migrations (common with
  // PgBouncer-style poolers), run `prisma migrate deploy` locally/in CI
  // against the direct (non-pooled) URL instead — see README.
  url = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COMPANY
  CANDIDATE
  RECRUITER
  INTERVIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  REJECTED
  // Phase 2: set when a candidate books an InterviewSlot (scheduling.service.js).
  INTERVIEW_SCHEDULED
  // Phase 2: set by the company once the interview has taken place.
  INTERVIEW_COMPLETED
  // Future statuses (OFFERED, HIRED, etc.) can be appended here later
  // without breaking existing rows.
}

enum ScreeningStatus {
  PENDING
  COMPLETED
  FAILED
}

// Demographic — profile/display data ONLY. Never read this field (or any
// gender value) when building an AI screening/matching prompt — see the
// guard rails in src/server/ai/candidate-matcher.service.js.
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AcademicStatus {
  ONGOING
  COMPLETED
}

enum InterviewSlotStatus {
  AVAILABLE
  BOOKED
  // A company can cancel a slot it created before it's booked, or after
  // (which also cancels the Interview — see scheduling.service.js).
  CANCELLED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EmailType {
  APPLICATION_SHORTLISTED
  APPLICATION_REJECTED
  INTERVIEW_CONFIRMATION
}

enum EmailStatus {
  SENT
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Core identity
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company?
  candidate Candidate?

  @@map("users")
}

model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  website     String?
  industry    String?
  size        String?
  location    String?
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@map("companies")
}

model Candidate {
  id       String   @id @default(cuid())
  userId   String   @unique
  fullName String
  phone    String?
  location String?
  headline String?
  skills   String[] @default([])

  // Demographic — collected for profile display only. NEVER passed into an
  // AI screening/matching prompt (see candidate-matcher.service.js).
  gender Gender?

  // Academic information (Section 4/5). Not restricted to B.Tech — `degree`
  // is a free-text exact degree name (e.g. "BCA", "B.Tech in Computer
  // Science and Technology", "MBA"). currentSemester only applies when
  // academicStatus is ONGOING; latestSpi doubles as "latest SPI" (ongoing)
  // or "final SPI" (completed) depending on academicStatus.
  university      String?
  college         String?
  degree          String?
  academicStatus  AcademicStatus?
  currentSemester Int?
  latestSpi       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes      Resume[]
  applications Application[]

  @@map("candidates")
}

// ─────────────────────────────────────────────────────────────
// Jobs
// ─────────────────────────────────────────────────────────────

model Job {
  id                     String         @id @default(cuid())
  companyId              String
  title                  String
  description            String
  minimumExperience      Float          @default(0)
  maximumExperience      Float?
  requiredSkills         String[]       @default([])
  preferredSkills        String[]       @default([])
  educationRequirements  String[]       @default([])
  location               String?
  employmentType         EmploymentType @default(FULL_TIME)
  status                 JobStatus      @default(OPEN)
  // AI-extracted structured requirements kept alongside the raw description
  // (see Section 12) — stored as JSON so the shape can evolve freely.
  structuredRequirements Json?

  // Per-job screening decision settings. minAcceptableScore is the bar a
  // screened application's overallScore is compared against; when
  // autoRejectBelowMinScore is true, screening.service.js automatically
  // marks anything below it REJECTED. When false (the default), screened
  // applications are left as SCREENING regardless of score — the company
  // decides via the manual/bulk Shortlist/Reject actions instead. Screening
  // NEVER auto-shortlists; only auto-reject is opt-in.
  minAcceptableScore      Float   @default(75)
  autoRejectBelowMinScore Boolean @default(false)

  createdBy              String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications   Application[]
  interviewSlots InterviewSlot[]

  @@index([companyId])
  @@index([status])
  @@map("jobs")
}

// ─────────────────────────────────────────────────────────────
// Resumes
// ─────────────────────────────────────────────────────────────

model Resume {
  id          String   @id @default(cuid())
  candidateId String
  fileName    String
  fileType    String
  fileSize    Int
  // Storage is abstracted behind a key/url pair so the implementation can
  // move from local disk (dev) to S3/R2/Cloudinary (prod) without schema
  // changes. See src/server/resume/storage.
  storageKey  String
  storageUrl  String?
  rawText     String?
  // AI-extracted structured resume data (see Section 11), validated before save.
  parsedData  Json?
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([candidateId])
  @@map("resumes")
}

// Backs the "database" storage driver (src/server/resume/storage/database.driver.js)
// — the production-safe default, since Vercel serverless functions have no
// writable persistent filesystem. A Resume's storageKey is this row's id;
// swapping to S3/R2/Cloudinary later means implementing cloud.driver.js and
// setting STORAGE_DRIVER=cloud — no schema or resumes.service.js changes.
model ResumeBlob {
  id        String   @id @default(cuid())
  data      Bytes
  createdAt DateTime @default(now())

  @@map("resume_blobs")
}

// ─────────────────────────────────────────────────────────────
// Applications & Screening
// ─────────────────────────────────────────────────────────────

model Application {
  id          String            @id @default(cuid())
  candidateId String
  jobId       String
  resumeId    String
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume          Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  screeningResult ScreeningResult?
  interviews      Interview[]

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@index([candidateId])
  @@map("applications")
}

model ScreeningResult {
  id                    String          @id @default(cuid())
  applicationId         String          @unique
  status                ScreeningStatus @default(PENDING)
  overallScore          Float?
  skillMatchScore       Float?
  experienceMatchScore  Float?
  educationMatchScore   Float?
  matchedSkills         String[]        @default([])
  missingSkills         String[]        @default([])
  strengths             String[]        @default([])
  concerns              String[]        @default([])
  reasoning             String?
  // Deterministic sub-checks computed outside the LLM (Section 13), kept for
  // transparency/auditability alongside the AI-derived scores.
  deterministicChecks   Json?
  aiModel               String?
  errorMessage          String?
  screenedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("screening_results")
}

// ─────────────────────────────────────────────────────────────
// Phase 2 — Notifications & interview scheduling
// (no Google Calendar / Twilio / LiveKit yet — see src/server/modules/scheduling
// and src/server/notifications)
// ─────────────────────────────────────────────────────────────

// A company-created, bookable time slot for a job's interviews. Company
// creates these ahead of time (Section: "Create available interview
// slots"); a candidate books one, which atomically flips it to BOOKED and
// creates an Interview row below (see scheduling.service.js's bookSlot,
// which uses a conditional update to prevent two candidates racing for the
// same slot). `interviews` is plural (not 1:1) because a slot cancelled
// after booking goes back to AVAILABLE and can be booked again by a
// different application later — each booking is its own Interview row, and
// InterviewSlot.status (not a DB constraint on Interview) is what actually
// decides bookability at any given moment.
model InterviewSlot {
  id        String              @id @default(cuid())
  jobId     String
  startTime DateTime
  endTime   DateTime
  status    InterviewSlotStatus @default(AVAILABLE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([jobId])
  @@index([status])
  @@map("interview_slots")
}

// A booking linking one Application to one InterviewSlot at the time it was
// made. Not @unique on applicationId/slotId — rescheduling creates a new
// row rather than mutating the old one, so a cancelled interview's history
// is preserved. At most one row per application should be SCHEDULED at a
// time; that's enforced by application-status gating in
// scheduling.service.js, not a DB constraint (the DB constraint that
// matters — preventing two candidates booking the same slot — is the
// AVAILABLE->BOOKED conditional update on InterviewSlot itself).
model Interview {
  id            String          @id @default(cuid())
  applicationId String
  slotId        String
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  slot        InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([slotId])
  @@map("interviews")
}

// Audit trail for every notification email the app has attempted to send
// (Section: status-change + interview confirmation emails). Kept even when
// sending fails, so failures are visible/debuggable rather than silent —
// see src/server/notifications/email/index.js.
model EmailLog {
  id             String      @id @default(cuid())
  applicationId  String?
  recipientEmail String
  type           EmailType
  subject        String
  status         EmailStatus
  errorMessage   String?
  sentAt         DateTime    @default(now())

  @@index([applicationId])
  @@map("email_logs")
}

