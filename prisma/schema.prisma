// Prisma schema for RecruitIQ — Phase 1
// Designed so Phase 2 (notifications, scheduling) and Phase 3 (interviews)
// can be added as new models/relations without altering these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // In production, DATABASE_URL should be your provider's POOLED connection
  // string — serverless functions open a fresh connection pool per
  // instance, and an unpooled URL exhausts small Postgres plans fast. If
  // your provider's pooled URL can't run migrations (common with
  // PgBouncer-style poolers), run `prisma migrate deploy` locally/in CI
  // against the direct (non-pooled) URL instead — see README.
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COMPANY
  CANDIDATE
  RECRUITER
  INTERVIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  REJECTED
  // Phase 2: set when a candidate books an InterviewSlot (scheduling.service.js).
  INTERVIEW_SCHEDULED
  // Phase 2: set by the company once the interview has taken place.
  INTERVIEW_COMPLETED
  // Future statuses (OFFERED, HIRED, etc.) can be appended here later
  // without breaking existing rows.
}

enum ScreeningStatus {
  PENDING
  COMPLETED
  FAILED
}

// Demographic — profile/display data ONLY. Never read this field (or any
// gender value) when building an AI screening/matching prompt — see the
// guard rails in src/server/ai/candidate-matcher.service.js.
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AcademicStatus {
  ONGOING
  COMPLETED
}

enum InterviewSlotStatus {
  AVAILABLE
  BOOKED
  // A company can cancel a slot it created before it's booked, or after
  // (which also cancels the Interview — see scheduling.service.js).
  CANCELLED
}

enum InterviewStatus {
  SCHEDULED
  // Phase 3: the candidate has joined the LiveKit room and the AI interview
  // question/answer loop is actively running.
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Deterministic, backend-controlled stage order for the AI interview state
// machine (Section 5) — the LLM chooses QUESTION TEXT within a stage and
// whether a follow-up is warranted, but never which stage comes next or how
// many stages there are; that's fixed here so "the AI does not freely
// control the entire interview."
enum InterviewStage {
  NOT_STARTED
  INTRODUCTION
  RESUME_QUESTIONS
  BASIC_TECHNICAL
  JOB_SPECIFIC
  SCENARIO
  BEHAVIORAL
  CANDIDATE_QUESTIONS
  END
}

enum InterviewQuestionType {
  INTRODUCTION
  CUSTOM
  RESUME_BASED
  TECHNICAL
  JOB_SPECIFIC
  SCENARIO
  FOLLOW_UP
  BEHAVIORAL
  CANDIDATE_QUESTION
}

// Section 4: browser-observed security/monitoring events during an AI
// interview. Never used for facial/emotion/lie-detection scoring — purely
// a presence/attention/connection audit trail.
enum InterviewEventType {
  CAMERA_ON
  CAMERA_OFF
  MIC_ON
  MIC_OFF
  TAB_SWITCH
  PAGE_LEFT
  FULLSCREEN_EXIT
  CONNECTION_LOST
  CONNECTION_RESTORED
  INTERVIEW_STARTED
  INTERVIEW_ENDED
}

enum InterviewReportStatus {
  PENDING
  COMPLETED
  FAILED
}

// Adaptive-difficulty axis for a planned question (Section 5). Null for
// INTRODUCTION, CANDIDATE_QUESTION, and CUSTOM-type questions, which aren't
// part of the difficulty ladder.
enum InterviewQuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// Company-configured AI interviewer voice (Section 8) — explicit, never
// inferred from the AI's name.
enum AiVoiceGender {
  FEMALE
  MALE
  NEUTRAL
}

// Whether question difficulty adapts to the candidate's answers, or stays
// fixed at MEDIUM throughout (Section 5).
enum DifficultyStrategy {
  FIXED
  ADAPTIVE
}

enum EmailType {
  APPLICATION_SHORTLISTED
  APPLICATION_REJECTED
  INTERVIEW_CONFIRMATION
}

enum EmailStatus {
  SENT
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Core identity
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company?
  candidate Candidate?

  @@map("users")
}

model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  website     String?
  industry    String?
  size        String?
  location    String?
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@map("companies")
}

model Candidate {
  id       String   @id @default(cuid())
  userId   String   @unique
  fullName String
  phone    String?
  location String?
  headline String?
  skills   String[] @default([])

  // Demographic — collected for profile display only. NEVER passed into an
  // AI screening/matching prompt (see candidate-matcher.service.js).
  gender Gender?

  // Academic information (Section 4/5). Not restricted to B.Tech — `degree`
  // is a free-text exact degree name (e.g. "BCA", "B.Tech in Computer
  // Science and Technology", "MBA"). currentSemester only applies when
  // academicStatus is ONGOING; latestSpi doubles as "latest SPI" (ongoing)
  // or "final SPI" (completed) depending on academicStatus.
  university      String?
  college         String?
  degree          String?
  academicStatus  AcademicStatus?
  currentSemester Int?
  latestSpi       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes      Resume[]
  applications Application[]

  @@map("candidates")
}

// ─────────────────────────────────────────────────────────────
// Jobs
// ─────────────────────────────────────────────────────────────

model Job {
  id                     String         @id @default(cuid())
  companyId              String
  title                  String
  description            String
  minimumExperience      Float          @default(0)
  maximumExperience      Float?
  requiredSkills         String[]       @default([])
  preferredSkills        String[]       @default([])
  educationRequirements  String[]       @default([])
  location               String?
  employmentType         EmploymentType @default(FULL_TIME)
  workMode               String         @default("On-site")
  openings               Int            @default(1)
  jobLevel               String         @default("Mid")
  noticePeriod           String?
  languagesRequired      String[]       @default([])
  certifications         String[]       @default([])
  salaryRange            String?
  status                 JobStatus      @default(OPEN)
  // AI-extracted structured requirements kept alongside the raw description
  // (see Section 12) — stored as JSON so the shape can evolve freely.
  structuredRequirements Json?

  // Per-job screening decision settings. minAcceptableScore is the bar a
  // screened application's overallScore is compared against; when
  // autoRejectBelowMinScore is true, screening.service.js automatically
  // marks anything below it REJECTED. When false (the default), screened
  // applications are left as SCREENING regardless of score — the company
  // decides via the manual/bulk Shortlist/Reject actions instead. Screening
  // NEVER auto-shortlists; only auto-reject is opt-in.
  minAcceptableScore      Float   @default(75)
  autoRejectBelowMinScore Boolean @default(false)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications      Application[]
  interviewSlots    InterviewSlot[]
  aiInterviewConfig AiInterviewConfig?

  @@index([companyId])
  @@index([status])
  @@map("jobs")
}

// ─────────────────────────────────────────────────────────────
// Resumes
// ─────────────────────────────────────────────────────────────

model Resume {
  id          String   @id @default(cuid())
  candidateId String
  fileName    String
  fileType    String
  fileSize    Int
  // Storage is abstracted behind a key/url pair so the implementation can
  // move from local disk (dev) to S3/R2/Cloudinary (prod) without schema
  // changes. See src/server/resume/storage.
  storageKey  String
  storageUrl  String?
  rawText     String?
  // AI-extracted structured resume data (see Section 11), validated before save.
  parsedData  Json?
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([candidateId])
  @@map("resumes")
}

// Backs the "database" storage driver (src/server/resume/storage/database.driver.js)
// — the production-safe default, since Vercel serverless functions have no
// writable persistent filesystem. A Resume's storageKey is this row's id;
// swapping to S3/R2/Cloudinary later means implementing cloud.driver.js and
// setting STORAGE_DRIVER=cloud — no schema or resumes.service.js changes.
model ResumeBlob {
  id        String   @id @default(cuid())
  data      Bytes
  createdAt DateTime @default(now())

  @@map("resume_blobs")
}

// ─────────────────────────────────────────────────────────────
// Applications & Screening
// ─────────────────────────────────────────────────────────────

model Application {
  id          String            @id @default(cuid())
  candidateId String
  jobId       String
  resumeId    String
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume          Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  screeningResult ScreeningResult?
  interviews      Interview[]

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@index([candidateId])
  @@map("applications")
}

model ScreeningResult {
  id                   String          @id @default(cuid())
  applicationId        String          @unique
  status               ScreeningStatus @default(PENDING)
  overallScore         Float?
  skillMatchScore      Float?
  experienceMatchScore Float?
  educationMatchScore  Float?
  matchedSkills        String[]        @default([])
  missingSkills        String[]        @default([])
  strengths            String[]        @default([])
  concerns             String[]        @default([])
  reasoning            String?
  // Deterministic sub-checks computed outside the LLM (Section 13), kept for
  // transparency/auditability alongside the AI-derived scores.
  deterministicChecks  Json?
  aiModel              String?
  errorMessage         String?
  screenedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("screening_results")
}

// ─────────────────────────────────────────────────────────────
// Phase 2 — Notifications & interview scheduling
// (no Google Calendar / Twilio / LiveKit yet — see src/server/modules/scheduling
// and src/server/notifications)
// ─────────────────────────────────────────────────────────────

// A company-created, bookable time slot for a job's interviews. Company
// creates these ahead of time (Section: "Create available interview
// slots"); a candidate books one, which atomically flips it to BOOKED and
// creates an Interview row below (see scheduling.service.js's bookSlot,
// which uses a conditional update to prevent two candidates racing for the
// same slot). `interviews` is plural (not 1:1) because a slot cancelled
// after booking goes back to AVAILABLE and can be booked again by a
// different application later — each booking is its own Interview row, and
// InterviewSlot.status (not a DB constraint on Interview) is what actually
// decides bookability at any given moment.
model InterviewSlot {
  id        String              @id @default(cuid())
  jobId     String
  startTime DateTime
  endTime   DateTime
  status    InterviewSlotStatus @default(AVAILABLE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([jobId])
  @@index([status])
  @@map("interview_slots")
}

// A booking linking one Application to one InterviewSlot at the time it was
// made. Not @unique on applicationId/slotId — rescheduling creates a new
// row rather than mutating the old one, so a cancelled interview's history
// is preserved. At most one row per application should be SCHEDULED at a
// time; that's enforced by application-status gating in
// scheduling.service.js, not a DB constraint (the DB constraint that
// matters — preventing two candidates booking the same slot — is the
// AVAILABLE->BOOKED conditional update on InterviewSlot itself).
model Interview {
  id            String          @id @default(cuid())
  applicationId String
  slotId        String
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Phase 3 — AI voice interview session state. Company/Job/Candidate are
  // reached via application (Application -> Job -> Company,
  // Application -> Candidate), not duplicated here.
  stage                InterviewStage @default(NOT_STARTED)
  liveKitRoomName      String?
  plannedQuestionIndex Int            @default(0)
  startedAt            DateTime?
  endedAt              DateTime?

  application Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  slot        InterviewSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  questions   InterviewQuestion[]
  events      InterviewEvent[]
  report      InterviewReport?

  @@index([applicationId])
  @@index([slotId])
  @@map("interviews")
}

// Company-configured AI interviewer settings, one per job (Section 1) — all
// interviews booked against a job's slots share the same interviewer
// persona/question budget. Falls back to sane defaults (see
// interviewConfig.service.js) when a company hasn't configured one yet, so
// AI slot generation/booking never depends on this existing first.
model AiInterviewConfig {
  id                 String             @id @default(cuid())
  jobId              String             @unique
  aiName             String             @default("Priya")
  aiTitle            String             @default("Virtual HR")
  questionCount      Int                @default(10)
  answerTimeSeconds  Int                @default(30)
  customQuestions    String[]           @default([])
  // Section 8: explicit voice config, never inferred from aiName.
  voiceGender        AiVoiceGender      @default(FEMALE)
  ttsVoiceId         String?
  // Section 5: adaptive by default; FIXED keeps every question at MEDIUM.
  difficultyStrategy DifficultyStrategy @default(ADAPTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("ai_interview_configs")
}

// One row per question actually asked (planned or follow-up). `index` is
// the question's position among PLANNED questions only (follow-ups share
// their parent's index) — this is what interviewEngine.service.js checks
// against AiInterviewConfig.questionCount to decide when the interview is
// done, kept separate from the LLM's own judgement (Section 8).
model InterviewQuestion {
  id                     String                       @id @default(cuid())
  interviewId            String
  index                  Int
  stage                  InterviewStage
  type                   InterviewQuestionType
  text                   String
  parentQuestionId       String?
  answerTimeLimitSeconds Int
  // Section 5: null for INTRODUCTION/CANDIDATE_QUESTION/CUSTOM questions,
  // which aren't part of the adaptive-difficulty ladder.
  difficulty             InterviewQuestionDifficulty?
  askedAt                DateTime                     @default(now())

  interview      Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  parentQuestion InterviewQuestion?  @relation("FollowUps", fields: [parentQuestionId], references: [id])
  followUps      InterviewQuestion[] @relation("FollowUps")
  answer         InterviewAnswer?

  @@index([interviewId])
  @@map("interview_questions")
}

model InterviewAnswer {
  id                   String   @id @default(cuid())
  questionId           String   @unique
  // Raw STT output, unmodified — kept for back-compat and as the input to
  // normalization; always equal to rawTranscript going forward.
  transcript           String
  // Section 2: normalization pipeline (STT -> raw -> normalized -> eval).
  rawTranscript        String   @default("")
  normalizedTranscript String   @default("")
  manuallyCorrected    Boolean  @default(false)
  correctedTranscript  String?
  // 0-1 confidence from the browser's SpeechRecognition result, when the
  // browser provides one (not all do) — informational only, never blocks.
  sttConfidence        Float?
  durationSeconds      Int?
  timedOut             Boolean  @default(false)
  // Lightweight in-the-moment evaluation used only to decide the next
  // question/follow-up (Section 8) — the deep, final evaluation lives on
  // InterviewReport instead, generated once after the interview ends.
  evaluation           Json?
  answeredAt           DateTime @default(now())

  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("interview_answers")
}

model InterviewEvent {
  id          String             @id @default(cuid())
  interviewId String
  type        InterviewEventType
  metadata    Json?
  occurredAt  DateTime           @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@map("interview_events")
}

// Final post-interview evaluation (Section 8) — generated once, after
// status moves to COMPLETED. questionAnalysis/resumeAlignment are
// structured JSON (question-by-question breakdown, deterministic
// skill-overlap reused from screening's deterministic.util.js blended with
// the LLM's qualitative read) rather than free text, mirroring
// ScreeningResult's pattern of never trusting the LLM as the sole source of
// truth for facts that can be computed directly.
model InterviewReport {
  id                  String                @id @default(cuid())
  interviewId         String                @unique
  status              InterviewReportStatus @default(PENDING)
  overallScore        Float?
  technicalScore      Float?
  communicationScore  Float?
  strengths           String[]              @default([])
  areasForImprovement String[]              @default([])
  questionAnalysis    Json?
  resumeAlignment     Json?
  reasoning           String?
  aiModel             String?
  errorMessage        String?
  generatedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_reports")
}

// Audit trail for every notification email the app has attempted to send
// (Section: status-change + interview confirmation emails). Kept even when
// sending fails, so failures are visible/debuggable rather than silent —
// see src/server/notifications/email/index.js.
model EmailLog {
  id             String      @id @default(cuid())
  applicationId  String?
  recipientEmail String
  type           EmailType
  subject        String
  status         EmailStatus
  errorMessage   String?
  sentAt         DateTime    @default(now())

  @@index([applicationId])
  @@map("email_logs")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 remainder — NOT implemented yet: CallLog (Twilio scheduling
// calls, actually a Phase 2 leftover) is the only model still deliberately
// omitted. AI voice interview models (AiInterviewConfig, InterviewQuestion,
// InterviewAnswer, InterviewEvent, InterviewReport) are implemented above.
// ─────────────────────────────────────────────────────────────
