# ── RecruitIQ backend ──
# Main app origin (no /api/v1). Local dev server: http://localhost:3001
BACKEND_URL=http://localhost:3001
# Must equal INTERVIEW_WORKER_SECRET in RecruitIQ's own .env
INTERVIEW_WORKER_SECRET=

# ── LiveKit (same project as RecruitIQ + livekit-twilow) ──
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Must match the agent name in the SIP dispatch rule (livekit-twilow created it as "doc-agent")
LIVEKIT_AGENT_NAME=doc-agent

# Speech models via LiveKit Inference (billed through LiveKit, no extra keys)
STT_MODEL=deepgram/nova-3:multi
TTS_MODEL=cartesia/sonic-3
# Optional: TTS voice ids so the AI voice follows the company's Female/Male setting
# TTS_VOICE_FEMALE=
# TTS_VOICE_MALE=

# ── Twilio (outbound calls) ──
# Twilio Console -> Account Info. NOT in livekit-twilow's .env — add them here.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# Only if the caller ID above differs from the number the LiveKit inbound trunk
# was created for (livekit-twilow's TWILIO_PHONE_NUMBER):
# LIVEKIT_TRUNK_NUMBER=

# Same values as livekit-twilow's .env (the LiveKit inbound trunk login)
# LIVEKIT_SIP_URI=
# SIP_AUTH_USER=
# SIP_AUTH_PASS=

# ── Tuning (optional) ──
# CALL_RING_SECONDS=30
# DIALER_POLL_SECONDS=15
# MAX_CONCURRENT_CALLS=3
# ANSWER_GRACE_SECONDS=2.5

# Console test (no phone): a PHONE interview id to run via  python agent.py console
# TEST_INTERVIEW_ID=
